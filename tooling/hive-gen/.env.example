# Copy to .env and fill in CARD_CORPUS_ROOT. Nothing here is an absolute path, on purpose:
# this file is what a new operator starts from, and a path under one machine's home
# directory is dead on every other machine.

# The CARD corpus working tree: the cards coming OUT. Taxonomies, drafts/ and .pipeline/
# are read and written here, and it is the tree hive-serve later serves. Required, and
# yours: the corpus is a separate repository, so there is no default worth guessing and
# the run refuses rather than proposing a taxonomy over one it cannot see.
# NOT hive-prep's CORPUS_ROOT, which is the raw documents going IN.
CARD_CORPUS_ROOT=

# Which functional area to generate. Empty means the whole corpus in one taxonomy.
SLICE_AREA=

# Source of truth. If ATOMIC_DIR is set, the pipeline reads clean atomic markdown
# from that local dir (scpp-prep/Docling never write markdown to R2) and R2 is
# not read. Leave it empty to fall back to the R2 reader below. It is hive-prep's
# ATOMIC_DIR output.
ATOMIC_DIR=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=example_prefix/
BIFROST_BASE=http://hive-host.internal:4001/v1
BIFROST_API_KEY=
TAXONOMY_MODEL=minimax-m3
ASSIGN_MODEL=deepseek-v4-flash
DISTILL_MODEL=minimax-m3
MAX_CHARS=24000
BIFROST_TIMEOUT_S=300
