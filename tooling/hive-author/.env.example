# Copy to .env. Nothing here is an absolute path, on purpose: this file is what a new
# operator starts from, and a path under one machine's home directory is dead on every
# other machine. No real host, repository or token belongs here either - this is the one
# service that holds a credential.

# Which forge this deployment files against: "github" or "forgejo". No default, and never
# inferred from FORGE_API: the two APIs disagree on the `labels` field, so guessing wrong
# sends label IDs to GitHub or label names to Forgejo and the submission fails at the
# moment somebody is waiting on it.
FORGE_KIND=

# The forge's API base. No default, and deliberately not a public one: a default pointing
# anywhere reachable lets a misconfigured deployment file submissions into a real
# repository that is not the intended one.
FORGE_API=

# The corpus repository submissions are filed against, as owner/name. No default: the
# corpus is a separate repository from this engine, and a wrong-but-plausible default
# files issues into someone else's.
FORGE_REPO=

# The credential. Scope it to opening issues on that one repository and nothing else -
# this service cannot push, merge or open a pull request, and that is the point of it
# being separate from hive-serve.
# Set FORGE_TOKEN *or* FORGE_TOKEN_FILE, never both. Use the file for a credential that
# expires faster than this process lives (a GitHub App installation token lasts an hour,
# so it cannot be an env var read once at startup); the client re-reads it on every
# submission.
FORGE_TOKEN=
FORGE_TOKEN_FILE=

HOST=127.0.0.1
PORT=8000

# The header the identity is read from. Trusted, not verified: the same trust model as
# hive-serve. See docs/guides/serving-cards.md#identity-and-what-it-is-not.
IDENTITY_HEADER=cf-access-authenticated-user-email

# Who a submission is attributed to when no identity header arrives.
OKF_DEFAULT_OWNER=local-operator
