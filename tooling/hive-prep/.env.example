# Copy to .env and fill in CORPUS_ROOT. Nothing here is an absolute path, on purpose:
# this file is what a new operator starts from, and a path under one machine's home
# directory is dead on every other machine. It is also the only kind of mistake here
# that does not announce itself - a stamp pass over a directory that is not there
# reports zero files changed and exits 0.

# The raw document tree to ingest (PDFs, Office files, ...): the documents going IN.
# Required, and yours: there is no default worth guessing. Commands refuse rather than
# proceed over nothing. NOT hive-gen's CARD_CORPUS_ROOT, which is the card corpus coming
# OUT of generation; the two name different trees and must not be exported as one value.
CORPUS_ROOT=

# Scratch space for conversion intermediates, and the atomic markdown that comes out of
# `transform`. Both are relative to the working directory and are created as needed, so
# they work from a fresh checkout. ATOMIC_DIR is what `hive-gen` reads next.
WORK_DIR=./hive-work
ATOMIC_DIR=./hive-work/atomic

# Docling, the preferred text converter. Leave DOCLING_BASE empty to use pymupdf4llm only.
DOCLING_BASE=
DOCLING_API_KEY=
DOCLING_CA_BUNDLE=

# The vision model endpoint, for pages with no extractable text. Any OpenAI-compatible
# endpoint serving a vision model; QWEN_MODEL must name one your gateway actually has.
QWEN_BASE=
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-27b
