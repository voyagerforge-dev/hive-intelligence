# Copy to .env. Nothing here is an absolute path, on purpose: this file is what a new
# operator starts from, and a path under one machine's home directory is dead on every
# other machine.

# Where the corpus is. The corpus is a separate repository from this engine, so none of
# these can be derived from where hive-serve is installed - they are yours to point.
# CONCEPTS_DIR holds the concept cards that are served and evaluated. The server refuses to
# start unless it names a directory, and the eval additionally refuses an empty one: unset
# is Path("."), which exists, so leaving it blank used to serve whatever markdown sat in
# the working directory as concept cards, and zero cards scores zero on every question.
CONCEPTS_DIR=
# Optional, and never a startup refusal. See docs/reference/hive-serve.md#the-resolver
# for client retrieval scope; this is not an authorization setting.
# Leave empty to disable client memory entirely - empty means off at every door, not the
# working directory. The eval then refuses only if the set it is given has rows that
# exercise it, rather than scoring them all as misses.
CLIENTS_DIR=
# Labelled eval sets, for `hiveserve.run_eval` only. Required by it and unset by default:
# sets name real card ids, so they ship with a corpus and there is nowhere here they could
# plausibly be. A bare qa-set name is resolved under this directory.
EVAL_DIR=

# The objective/memory ledger. Postgres, required: there is no file fallback, because
# falling back is how an empty ledger gets served as if it were the real one.
LEDGER_DSN=

# The model gateway. Any OpenAI-compatible endpoint works; the API key is your own.
BIFROST_BASE=https://openrouter.ai/api/v1
BIFROST_API_KEY=
# Model ids must be names the endpoint above actually serves. OpenRouter namespaces them by
# provider (`deepseek/deepseek-v4-flash-0731`); a bare id now reaches a live endpoint and
# comes back as an unknown model, so the error names the model rather than this setting.
# Prefer one that pins a release: `deepseek-v4-flash` and `deepseek-v4` both resolve to the
# April 23 Flash release, so a report naming them does not say which release produced it.
SELECT_MODEL=deepseek-v4-flash-0731
# Quota is part of that: an exhausted plan fails calls even with a valid key. For empty
# responses, see docs/reference/hive-serve.md#a-model-that-returns-nothing-fails-the-run.
ANSWER_MODEL=deepseek-v4-pro
JUDGE_MODEL=deepseek-v4-pro
BIFROST_TIMEOUT_S=300
MAX_CARDS=8
# ~10K tokens. 80000 produced ~18K-token bundles that overran the MCP client's per-result
# token cap and spilled to a file, forcing chunked re-reads.
MAX_CHARS=40000
RESOLVE_DEPTH=1
