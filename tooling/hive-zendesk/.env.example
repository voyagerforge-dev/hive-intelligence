# Copy to .env. Nothing here is an absolute path, on purpose: this file is what a new
# operator starts from, and a path under one machine's home directory is dead on every
# other machine. No deployment's host, bucket or credential belongs here either - the
# public gateway address below is a shareable default, the API key beside it is not.

# The ticket connector. No default: a connector address belongs to a deployment, and a
# plausible-looking one fails late and against the wrong host rather than at startup.
CONNECTOR_BASE=
CONNECTOR_API_KEY=

# The corpus profile, for its `linking` section: the default product, the per-product
# markers and the extra stopwords. Read from the process environment, so it must be
# EXPORTED to have any effect - a value set only here never reaches os.environ, where the
# lookup looks. Empty means look for corpus-profile.yaml in the working directory.
CORPUS_PROFILE=

# The model gateway. Any OpenAI-compatible endpoint works; the API key is your own.
BIFROST_BASE=https://openrouter.ai/api/v1
BIFROST_API_KEY=

# No default, and the run refuses without it (or --model). An environment that fails to
# load .env would otherwise distil an entire run with a different model than intended,
# silently, and the cards would carry no sign of which one wrote them.
DISTILL_MODEL=

# Linking is a separate job from distilling and is measured separately, so it has its own
# model. The cheap tier is the default; a stronger model is an on-demand escalation.
RERANK_MODEL=minimax-m3

BIFROST_TIMEOUT_S=300

# Must cover reasoning AND the answer for a reasoning model. At 2000 it spends the whole
# budget thinking and returns nothing.
DISTILL_MAX_TOKENS=4000

# The connector's own ceiling: max_pages(30) * page_size(100). CAP_WARN_RATIO is the
# fraction of it treated as "probably truncated", because a truncated pull looks exactly
# like a complete one.
CONNECTOR_PAGE_CAP=3000
CAP_WARN_RATIO=0.95

# R2, holding cards already staged by an earlier run. All four are needed for `rebuild`.
# R2_ENDPOINT and R2_BUCKET are additionally refused at startup, naming the one missing,
# because unset they do not fail loudly: an empty endpoint surfaces as a botocore
# "Invalid endpoint:" several frames down, and a bucket that is not yours lists nothing,
# which reads exactly like a bucket with nothing staged in it.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The reshape step in `rebuild`. Workers only load the model gateway - the connector is
# untouched there. Batch size 5 measured 2.4x fewer tokens per entry than 1; larger
# batches risk a long single request and an all-or-nothing parse.
RESHAPE_WORKERS=6
RESHAPE_BATCH_SIZE=5
